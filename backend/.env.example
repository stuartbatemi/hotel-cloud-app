# --- PostgreSQL (Aiven for PostgreSQL — free tier) ---
# From your Aiven service's "Connection information" panel:
DB_HOST=
DB_PORT=
DB_USER=avnadmin
DB_PASSWORD=
DB_NAME=defaultdb
DB_SSL=true
DB_SSL_CA_PATH=./certs/aiven-ca.pem

# --- Local development only ---
# true = skip Firebase token checks so staff routes work before a Firebase
# project exists. Fine to leave true for now; set to false once Firebase Auth
# is wired in (a later phase).
DEV_SKIP_AUTH=true

# --- Firebase Admin (service account, for verifying tokens + Storage) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# --- Server ---
PORT=4000
CORS_ORIGIN=http://localhost:5173
